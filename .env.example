# Copy thành .env rồi điền giá trị thật. File .env KHÔNG được commit (đã có trong .gitignore).
# IntelliJ: Run > Edit Configurations > Environment variables (hoặc plugin EnvFile trỏ tới .env).
# Sinh chuỗi ngẫu nhiên: openssl rand -base64 48

# --- Database (Neon của nhóm: hỏi Việt Anh; Postgres local: DB_HOST=localhost:5432, DB_SSLMODE=disable) ---
DB_HOST=ep-xxxx.ap-southeast-1.aws.neon.tech
DB_NAME=p03
DB_USER=p03_app
DB_PASSWORD=change-me
DB_SSLMODE=require

# --- Backend ---
# >= 32 byte (256 bit)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Chỉ dùng cho Postgres local trong docker-compose ---
POSTGRES_PASSWORD=change-me-superuser
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app
DB_READONLY_PASSWORD=change-me-readonly
DB_BACKUP_PASSWORD=change-me-backup
