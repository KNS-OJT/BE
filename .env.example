# Copy thành .env rồi điền giá trị thật. File .env KHÔNG được commit (đã có trong .gitignore).
# IntelliJ: Run > Edit Configurations > Environment variables (hoặc plugin EnvFile trỏ tới .env).
# Sinh chuỗi ngẫu nhiên: openssl rand -base64 48

# --- Database (Neon: dùng direct endpoint, không dùng hostname có hậu tố -pooler) ---
DB_HOST=ep-xxxx.c-2.ap-southeast-1.aws.neon.tech
DB_NAME=p03
DB_USER=p03_app
DB_PASSWORD=change-me
DB_SSLMODE=verify-full
DB_CHANNEL_BINDING=require
# Đặt ISRG Root X1 PEM tại ~/.postgresql/root.crt (Windows: %APPDATA%\\postgresql\\root.crt).

# --- Backend ---
# >= 32 byte (256 bit)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Chỉ dùng cho Postgres local trong docker-compose ---
# Local PostgreSQL không bật TLS: DB_HOST=localhost:5432, DB_SSLMODE=disable, DB_CHANNEL_BINDING=disable.
POSTGRES_PASSWORD=change-me-superuser
DB_APP_PASSWORD=change-me-app
DB_READONLY_PASSWORD=change-me-readonly
DB_BACKUP_PASSWORD=change-me-backup
