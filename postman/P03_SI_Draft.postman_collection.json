{
  "info": {
    "name": "P03 SI Draft - team sample v0.1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Draft requests only. Run Auth then SI in order. Creates one new local Draft each run; no delete API. Workflow proposal is separate. Contract assertions are expectations, not proof of execution."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base=pm.environment.get(\"baseUrl\");",
          "if(!/^http:\\/\\/(localhost|127\\.0\\.0\\.1):\\d+$/.test(base||\"\")) throw new Error(\"This sample is restricted to a local backend\");",
          "if(pm.request.url.toString().includes(\"/stock-issues\")) {",
          " if(pm.request.url.toString().includes(\"{{issue_id}}\") && !pm.environment.get(\"issue_id\")) throw new Error(\"Run create first\");",
          " const pid=Number(pm.environment.get(\"product_id\")); if(!Number.isInteger(pid)||pid<=0) throw new Error(\"Set an active product_id\");",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 Auth - fill passwords locally",
      "item": [
        {
          "name": "Login owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{{login_body}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"token_owner\");",
                  "const password=pm.environment.get(\"owner_password\");",
                  "if(!password) throw new Error(\"Fill owner_password locally before running\");",
                  "pm.variables.set(\"login_body\", JSON.stringify({username:pm.environment.get(\"owner_username\"),password}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "pm.test(\"Role\", () => pm.expect(j.role).to.eql(\"REQUESTER\"));",
                  "if(pm.response.code===200 && j.accessToken && j.role===\"REQUESTER\") { pm.environment.set(\"token_owner\",j.accessToken); pm.environment.set(\"user_owner\",j.userId); } else { pm.execution.setNextRequest(null); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login other",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{{login_body}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"token_other\");",
                  "const password=pm.environment.get(\"other_password\");",
                  "if(!password) throw new Error(\"Fill other_password locally before running\");",
                  "pm.variables.set(\"login_body\", JSON.stringify({username:pm.environment.get(\"other_username\"),password}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "pm.test(\"Role\", () => pm.expect(j.role).to.eql(\"REQUESTER\"));",
                  "if(pm.response.code===200 && j.accessToken && j.role===\"REQUESTER\") { pm.environment.set(\"token_other\",j.accessToken); pm.environment.set(\"user_other\",j.userId); } else { pm.execution.setNextRequest(null); }",
                  "pm.test(\"Different requester accounts\",()=>pm.expect(Number(pm.environment.get(\"user_other\"))).not.to.eql(Number(pm.environment.get(\"user_owner\"))));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login purchasing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{{login_body}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"token_purchasing\");",
                  "const password=pm.environment.get(\"purchasing_password\");",
                  "if(!password) throw new Error(\"Fill purchasing_password locally before running\");",
                  "pm.variables.set(\"login_body\", JSON.stringify({username:pm.environment.get(\"purchasing_username\"),password}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "pm.test(\"Role\", () => pm.expect(j.role).to.eql(\"PURCHASING_STAFF\"));",
                  "if(pm.response.code===200 && j.accessToken && j.role===\"PURCHASING_STAFF\") { pm.environment.set(\"token_purchasing\",j.accessToken); pm.environment.set(\"user_purchasing\",j.userId); } else { pm.execution.setNextRequest(null); }"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "01 SI Draft - run in order",
      "item": [
        {
          "name": "01 Create own Draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/stock-issues",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_owner}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"reason\":\"SI Postman local test\",\"items\":[{\"productId\":{{product_id}},\"quantity\":2}]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"issue_id\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const j=pm.response.json();",
                  "pm.test(\"Own DRAFT\",()=>{pm.expect(j.status).to.eql(\"DRAFT\");pm.expect(j.requestedBy).to.eql(Number(pm.environment.get(\"user_owner\")));});",
                  "if(pm.response.code===201 && j.id && j.status===\"DRAFT\") pm.environment.set(\"issue_id\",j.id); else pm.execution.setNextRequest(null);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "02 Read own Draft",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/stock-issues/{{issue_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_owner}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Correct issue\",()=>pm.expect(pm.response.json().id).to.eql(Number(pm.environment.get(\"issue_id\"))));"
                ]
              }
            }
          ],
          "response": []
        },
