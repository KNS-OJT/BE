{
  "openapi": "3.0.3",
  "info": {
    "title": "P03 — SI workflow PROPOSAL ONLY",
    "version": "0.1.0-proposal",
    "description": "CHƯA TRIỂN KHAI. Endpoint, payload, HTTP và quyền trong file này cần nhóm chốt. Không dùng file này làm bằng chứng backend hỗ trợ luồng duyệt."
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "Local test"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/stock-issues/{id}/submit": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "post": {
        "operationId": "proposedSubmit",
        "tags": [
          "PROPOSED - NOT IMPLEMENTED"
        ],
        "summary": "Chủ phiếu: DRAFT → SUBMITTED",
        "x-implementation-status": "proposed",
        "description": "Chủ phiếu: DRAFT → SUBMITTED. Response 200 với Issue là đề xuất. Sai trạng thái 409 INVALID_STATE; sai vai trò 403; SoD 403 SOD_VIOLATION. Cần chốt thứ tự kiểm tra quyền/ownership.",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Issue"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR / UNKNOWN_FIELD",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED / TOKEN_EXPIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN_ROLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND (bao gồm khác chủ phiếu)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "INVALID_STATE (sửa phiếu không phải DRAFT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
