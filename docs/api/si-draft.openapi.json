{
  "openapi": "3.0.3",
  "info": {
    "title": "P03 — SI Draft contract for review",
    "version": "0.1.0-review",
    "description": "Soạn từ source đã bàn giao và bằng chứng local; chưa phải contract được nhóm phê duyệt. Chỉ gồm Auth hỗ trợ và 4 API SI Draft. Luồng đề xuất nằm trong file riêng."
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "Local test"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "tags": [
          "Auth shared"
        ],
        "summary": "Lấy token phục vụ kiểm thử",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CREDENTIALS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/stock-issues": {
      "get": {
        "operationId": "listOwnIssues",
        "tags": [
          "Stock Issue Draft"
        ],
        "summary": "Danh sách phiếu của mình",
        "x-implementation-status": "implemented",
        "description": "REQUESTER, WAREHOUSE_STAFF, MANAGER; chỉ phiếu của chính người gọi. Chờ nhóm duyệt contract.",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuePage"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR / UNKNOWN_FIELD",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED / TOKEN_EXPIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN_ROLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 20,
              "maximum": 100
            }
          }
        ]
      },
      "post": {
        "operationId": "createDraft",
        "tags": [
          "Stock Issue Draft"
        ],
        "summary": "Tạo Draft",
        "x-implementation-status": "implemented",
        "description": "REQUESTER, WAREHOUSE_STAFF, MANAGER; chỉ phiếu của chính người gọi. Chờ nhóm duyệt contract.",
        "responses": {
          "201": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Issue"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR / UNKNOWN_FIELD",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED / TOKEN_EXPIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN_ROLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDraftRequest"
              },
              "example": {
                "reason": "Cap vat tu",
                "items": [
                  {
                    "productId": 4,
                    "quantity": 3
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/api/stock-issues/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "get": {
        "operationId": "getOwnIssue",
        "tags": [
          "Stock Issue Draft"
        ],
        "summary": "Đọc phiếu của mình",
        "x-implementation-status": "implemented",
        "description": "REQUESTER, WAREHOUSE_STAFF, MANAGER; chỉ phiếu của chính người gọi. Chờ nhóm duyệt contract.",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Issue"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR / UNKNOWN_FIELD",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED / TOKEN_EXPIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN_ROLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND (bao gồm khác chủ phiếu)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateOwnDraft",
        "tags": [
          "Stock Issue Draft"
        ],
        "summary": "Thay toàn bộ reason/items của Draft",
        "x-implementation-status": "implemented",
        "description": "REQUESTER, WAREHOUSE_STAFF, MANAGER; chỉ phiếu của chính người gọi. Chờ nhóm duyệt contract.",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Issue"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR / UNKNOWN_FIELD",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED / TOKEN_EXPIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN_ROLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND (bao gồm khác chủ phiếu)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "INVALID_STATE (sửa phiếu không phải DRAFT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDraftRequest"
              },
              "example": {
                "reason": "Cap vat tu",
                "items": [
                  {
                    "productId": 4,
                    "quantity": 3
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LineInput": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "quantity": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 99999999999.999,
            "multipleOf": 0.001
          }
        },
        "required": [
          "productId",
          "quantity"
        ],
        "additionalProperties": false
      },
      "CreateDraftRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S",
            "description": "Không được chỉ chứa khoảng trắng."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/LineInput"
            },
            "description": "productId không trùng và sản phẩm phải đang hoạt động."
          }
        },
        "required": [
          "reason",
          "items"
        ],
        "additionalProperties": false
      },
      "UpdateDraftRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S",
            "description": "Không được chỉ chứa khoảng trắng."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/LineInput"
            },
            "description": "productId không trùng và sản phẩm phải đang hoạt động."
          }
        },
        "required": [
          "reason",
          "items"
        ],
        "additionalProperties": false
      },
      "Issue": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "issueCode": {
            "type": "string"
          },
          "requestedBy": {
            "type": "integer",
            "format": "int64"
          },
          "confirmedBy": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "CONFIRMED",
              "CANCELED"
            ]
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "reason": {
            "type": "string"
          },
          "cancelReason": {
            "type": "string",
            "nullable": true
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "format": "int64"
                },
                "productId": {
                  "type": "integer",
                  "format": "int64"
                },
                "quantity": {
                  "type": "number"
                }
              },
              "required": [
                "id",
                "productId",
                "quantity"
              ]
            }
          }
        },
        "required": [
          "id",
          "issueCode",
          "requestedBy",
          "confirmedBy",
          "status",
          "requestedAt",
          "confirmedAt",
          "reason",
          "cancelReason",
          "items"
        ]
      },
      "IssuePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Issue"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "totalElements": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ]
            }
          }
        },
        "required": [
          "status",
          "code",
          "message",
          "requestId"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "format": "password"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "additionalProperties": false
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer"
          },
          "role": {
            "type": "string"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "fullName": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "role",
          "userId",
          "username",
          "fullName"
        ]
      }
    }
  }
}
